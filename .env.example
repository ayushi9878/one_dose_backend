# Copy to .env and fill in real values. NEVER commit .env.
#
# This file matches deployment/docker-compose.yml: MySQL runs as the "mysql"
# service and Spring Boot reaches it by that service name on its standard
# internal port 3306 — Docker's network resolves "mysql" to the container, so
# this is not a hardcoded host, it's the compose service name.
#
# Running the backend directly on Windows (not via Docker) instead? Your local
# MySQL listens on a different host/port, so use backend/.env.local.example as
# the template instead — see deployment/run-local.md.
#
# Generate a strong JWT secret with:
#   openssl rand -base64 48

# ---- Database (Docker Compose network) --------------------------------------
DB_HOST=mysql
DB_PORT=3306
DB_NAME=careflow
DB_USERNAME=careflow
DB_PASSWORD=change-me-strong-password
DB_USE_SSL=false

# Root password used only to initialise the local MySQL container.
MYSQL_ROOT_PASSWORD=change-me-root-password

# Host port that the local MySQL container publishes to.
DB_HOST_PORT=3306

# ---- Security ---------------------------------------------------------------
# Must supply at least 32 bytes of key material for HS256.
JWT_SECRET=change-me-generate-a-long-random-secret-value
JWT_EXPIRATION_MINUTES=480

# ---- Application ------------------------------------------------------------
APP_VERSION=1.0.0
APP_ENV=local
SERVER_PORT=8080
BACKEND_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Populates fictional demo data on first start. Keep false in production.
SEED_ENABLED=true

# Injected by CI at build time; leave as-is locally.
GIT_COMMIT=local
DEPLOYED_AT=local

# ---- Optional AI case summaries (Groq) --------------------------------------
# Disabled by default. When off, escalation summaries use a deterministic
# template. The risk engine is always deterministic and never uses AI.
GROQ_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Frontend (runs natively — see frontend/.env.local, not this file) ------
# The frontend deploys to Vercel and runs locally via `npm run dev`, not
# through Docker Compose. This value is for local dev only; Vercel gets its
# own NEXT_PUBLIC_API_URL from its project environment variables.
NEXT_PUBLIC_API_URL=http://localhost:8080
