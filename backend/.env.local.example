# Template for running the Spring Boot backend directly on Windows (mvnw
# spring-boot:run), OUTSIDE Docker, against your local MySQL 8 service.
#
# Copy to backend\.env.local, fill in the real DB_PASSWORD you set when you
# ran deployment\local-mysql-setup.sql, then load it into your shell before
# starting the app (see deployment\run-local.md). NEVER commit .env.local.
#
# Your local MySQL 8 service listens on port 3307, not the MySQL default of
# 3306 — that is specific to this machine and is never hardcoded in source;
# it only ever exists in this file / your shell environment.
DB_HOST=localhost
DB_PORT=3307
DB_NAME=careflow
DB_USERNAME=careflow
DB_PASSWORD=CHANGE_ME
DB_USE_SSL=false

# Must supply at least 32 bytes of key material for HS256.
JWT_SECRET=CHANGE_ME

APP_ENV=local
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000
SEED_ENABLED=true
