# Environment and secrets — never commit real values.
# Both bare and nested forms, since .env files live at the repo root and inside
# the frontend package. The .env.* wildcard covers every variant (.env.local,
# .env.production, etc). Any *.example file is a placeholder template, never a
# real secret, so every such file is explicitly re-allowed and must stay
# tracked — this covers .env.example, backend/.env.local.example, and any
# future *.env*.example files the same way.
.env
**/.env
.env.*
**/.env.*
!*.example
!**/*.example
*.pem
*.key
service-account*.json

# Java / Maven
target/
!.mvn/wrapper/maven-wrapper.jar
*.class
*.jar
!**/src/main/**/*.jar
!**/src/test/**/*.jar
*.log
hs_err_pid*

# Node / Next.js
node_modules/
.next/
out/
build/
dist/
.npm
*.tsbuildinfo
next-env.d.ts

# Auto-generated by the Next.js dev server on first run — not project content.
AGENTS.md
CLAUDE.md

# Test and coverage output
coverage/
.nyc_output/
surefire-reports/

# IDE and OS
.idea/
.vscode/
*.iml
*.swp
.DS_Store
Thumbs.db
