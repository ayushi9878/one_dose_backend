# Environment and secrets — never commit real values.
# Both bare and nested forms, since .env files live at the repo root and inside
# the frontend package.
.env
**/.env
.env.local
**/.env.local
.env.*.local
**/.env.*.local
*.pem
*.key
service-account*.json

# Java / Maven
target/
!.mvn/wrapper/maven-wrapper.jar
*.class
*.jar
!**/src/main/**/*.jar
!**/src/test/**/*.jar
*.log
hs_err_pid*

# Node / Next.js
node_modules/
.next/
out/
build/
dist/
.npm
*.tsbuildinfo
next-env.d.ts

